{
  "name": "bepoliticallyaware",
  "private": true,
  "type": "module",
  "packageManager": "bun@1.4.0",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev --host 127.0.0.1",
    "build": "bun run check && astro build",
    "preview": "astro preview --host 127.0.0.1",
    "check": "astro check && tsc --noEmit",
    "test": "bun test",
    "validate:content": "bun scripts/validate_content.ts",
    "validate": "bun run validate:content && bun run build && bun test"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.10",
    "@tailwindcss/vite": "^4.3.3",
    "@types/bun": "latest",
    "@types/hast": "^3",
    "@types/node": "^26.6.5",
    "@types/sanitize-html": "^2.16.2",
    "cheerio": "^1.2.0",
    "prettier": "^3.9.10",
    "prettier-plugin-astro": "^1.1.1",
    "tailwindcss": "^4.3.3",
    "typescript": "6.0.3"
  },
  "dependencies": {
    "@astrojs/markdown-satteri": "0.4.3",
    "astro": "^7.3.8",
    "hast-util-sanitize": "5.0.2",
    "minisearch": "^7.2.0",
    "sanitize-html": "^2.18.0",
    "satteri": "0.10.5"
  }
}
