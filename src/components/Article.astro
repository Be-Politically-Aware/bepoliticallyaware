---
import type { Article } from "../../implementation/content-types";
import { copy, dateLabel, navigation } from "../lib/content";
import { renderMarkdown } from "../lib/markdown";
import { evidence, evidenceTable } from "../lib/evidence";
interface Props {
  article: Article;
}
const { article } = Astro.props;
const hub = navigation.hubs.find((h) => h.id === article.hub)!;
const card = evidence.find((c) => c.articleId === article.id);
const { html, headings } = renderMarkdown(
  article.body_markdown,
  card?.replacesTable ? evidenceTable(card) : undefined,
);
const isGlossary = article.id === "in-reference-glossary";
const indexHeadings = isGlossary
  ? [...headings].sort((a, b) => a.text.localeCompare(b.text))
  : headings;
const correction = `Article: ${article.title}\nArticle ID: ${article.id}\nRoute: ${article.route}\nVersion: ${article.version}\nResearch checked: ${article.research_checked_at}\n\nOriginal claim:\n\nSource URL and exact locator:\n\nProposed correction:\n\nReason and supporting evidence:\n`;
---

<article>
  <header class="article-header">
    <nav class="breadcrumb" aria-label="Breadcrumb">
      <a href="/in">India</a> / <a href={hub.route}>{hub.label}</a>
    </nav>
    <h1>{article.title}</h1>
    <p class="lead">{article.summary}</p>
    <div class="meta">
      <span>{article.estimated_reading_minutes} min read</span>
      <span>
        {copy.article_labels.checked}{" "}
        <time datetime={article.research_checked_at}>
          {dateLabel(article.research_checked_at)}
        </time>
      </span>
    </div>
  </header>
  <details class:list={["on-this-page", { "glossary-index": isGlossary }]}>
    <summary>{isGlossary ? "Find a term (A–Z)" : "On this page"}</summary>
    <ul>
      {indexHeadings.map((h) => (
        <li>
          <a href={`#${h.id}`}>{h.text}</a>
        </li>
      ))}
      <li>
        <a href="#sources">Sources and scope</a>
      </li>
    </ul>
  </details>
  <div class="prose" set:html={html} />
  {card && (
    <section id="evidence-data" class="article-extra">
      <h2>The data behind this example</h2>
      {!card.replacesTable && <Fragment set:html={evidenceTable(card)} />}
      <p class="source-note">{card.scope}</p>
      <ul class="source-note">
        {card.data.limitations.map((limit) => (
          <li>{limit}</li>
        ))}
      </ul>
      <a href={`/data/${card.data.id}.json`} download>
        Download the source-linked data (JSON)
      </a>
      <p class="fine-print">
        Research checked {dateLabel(card.data.checked_at)}. Not a live data
        feed.
      </p>
    </section>
  )}
  <section class="article-extra">
    <div class="task">
      <h2>{copy.article_labels.task}</h2>
      <p>{article.reader_task}</p>
    </div>
  </section>
  <section class="article-extra">
    <h2>{copy.article_labels.related}</h2>
    <ul class="reading-list">
      {article.related.map((related) => (
        <li>
          <a href={related.route}>{related.title}</a>
        </li>
      ))}
    </ul>
  </section>
  <section class="article-extra sources" id="sources">
    <h2>{copy.article_labels.sources}</h2>
    <p class="source-note">
      The check date records a research check, not continuous monitoring or a
      guarantee of current law.
    </p>
    <ol>
      {article.sources.map((source) => (
        <li id={`source-${source.number}`}>
          <a href={source.url}>{source.title}</a>
          <p>{source.publisher}</p>
          <p>
            <strong>Exact locator:</strong> {source.locator}
          </p>
          <dl>
            {source.version && (
              <>
                <dt>Edition / cutoff</dt>
                <dd>{source.version}</dd>
              </>
            )}
            {source.published_at && (
              <>
                <dt>Source published</dt>
                <dd>{source.published_at}</dd>
              </>
            )}
            {source.reference_period && (
              <>
                <dt>Reference period</dt>
                <dd>{source.reference_period}</dd>
              </>
            )}
          </dl>
          {source.limitations.length > 0 && (
            <p>
              <strong>Limits:</strong> {source.limitations.join(" ")}
            </p>
          )}
          <p class="fine-print">
            Source checked {dateLabel(source.checked_at)}
          </p>
        </li>
      ))}
    </ol>
  </section>
  <details class="article-extra correction" data-article-id={article.id}>
    <summary>{copy.article_labels.correction}</summary>
    <p class="source-note">
      Prepare a draft to copy or download. Nothing is sent or saved by this
      website; a submission destination has not been configured.
    </p>
    <label for="correction-draft">Correction draft</label>
    <textarea id="correction-draft" spellcheck="true">{correction}</textarea>
    <div class="correction-actions">
      <button id="copy-correction" hidden>
        Copy draft
      </button>
      <a
        id="download-correction"
        class="button"
        href={`data:text/plain;charset=utf-8,${encodeURIComponent(correction)}`}
        download={`${article.id}-correction.txt`}
      >
        Download draft
      </a>
    </div>
    <p id="correction-status" class="status" role="status"></p>
  </details>
  <p class="fine-print article-extra">
    Article version {article.version}. Research checked{" "}
    {dateLabel(article.research_checked_at)}.<br />
    Assistant source checks; not independently human-reviewed.{" "}
    <a href="/in/reference/how-we-know">Read our methods</a>.
  </p>
</article>
<script>
  const draft =
    document.querySelector<HTMLTextAreaElement>("#correction-draft")!;
  const copyButton =
    document.querySelector<HTMLButtonElement>("#copy-correction")!;
  const download = document.querySelector<HTMLAnchorElement>(
    "#download-correction",
  )!;
  const status = document.querySelector<HTMLElement>("#correction-status")!;
  copyButton.hidden = false;
  draft.addEventListener("input", () => {
    download.href = `data:text/plain;charset=utf-8,${encodeURIComponent(draft.value)}`;
    status.textContent = "";
  });
  copyButton.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(draft.value);
      status.textContent = "Draft copied. Nothing has been submitted.";
    } catch {
      draft.focus();
      draft.select();
      status.textContent = "Select and copy the draft, or download it below.";
    }
  });
</script>
