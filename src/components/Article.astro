---
import { render } from "astro:content";
import type { Article } from "../lib/content";
import { copy, dateLabel, glossary, sourceDirectory } from "../lib/content";
import { getNavigation } from "../lib/nav";
import Pager from "./Pager.astro";
import DataPanels from "./DataPanels.astro";
import { evidence, evidenceTable } from "../lib/evidence";
interface Props {
  article: Article;
}
const { article } = Astro.props;
const { section, hub } = getNavigation(article.route);
const card = evidence.find((c) => c.articleId === article.id);
const { Content, headings } = await render(article.entry);
const isGlossary = article.id === "in-reference-glossary";
const extraTerms = isGlossary
  ? glossary
      .filter(
        (term) =>
          !headings.some(
            (heading) => heading.depth === 2 && heading.text === term.term,
          ),
      )
      .map((term) => ({
        ...term,
        slug: `section-${term.term
          .toLowerCase()
          .replace(/[^a-z0-9]+/g, "-")
          .replace(/-$/, "")}`,
      }))
  : [];
const indexHeadings = isGlossary
  ? [
      ...headings.filter((h) => h.depth === 2),
      ...extraTerms.map((term) => ({ text: term.term, slug: term.slug })),
    ].sort((a, b) => a.text.localeCompare(b.text))
  : [];
const correction = `Article: ${article.title}\nArticle ID: ${article.id}\nRoute: ${article.route}\nVersion: ${article.version}\nResearch checked: ${article.research_checked_at}\n\nOriginal claim:\n\nSource URL and exact locator:\n\nProposed correction:\n\nReason and supporting evidence:\n`;
---

<article class="article">
  <header class="article-header">
    <nav class="context" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/in">India</a>
        </li>
        {section && (
          <li>
            <span aria-hidden="true">/</span>{" "}
            <a href={section.route}>{section.label}</a>
          </li>
        )}
        {hub && hub.label !== section?.label && (
          <li>
            <span aria-hidden="true">/</span>{" "}
            <a href={hub.route}>{hub.label}</a>
          </li>
        )}
      </ol>
    </nav>
    <h1>{article.title}</h1>
    <p class="summary">{article.summary}</p>
    <p class="meta">
      Research checked{" "}
      <time datetime={article.research_checked_at}>
        {dateLabel(article.research_checked_at)}
      </time>{" "}
      · {article.estimated_reading_minutes} min read · v{article.version}
    </p>
  </header>
  {isGlossary && (
    <details class="az" open>
      <summary>Find a term (A–Z)</summary>
      <ul>
        {indexHeadings.map((h) => (
          <li>
            <a href={`#${h.slug}`}>{h.text}</a>
          </li>
        ))}
      </ul>
    </details>
  )}
  <div class="prose">
    <Content />
    {extraTerms.length > 0 && (
      <>
        <p class="source-note">
          Additional terms from expansion v3. Sources checked 14 October 2026;
          the original definitions retain their earlier research date.
        </p>
        {extraTerms.map((term) => (
          <>
            <h2 id={term.slug}>{term.term}</h2>
            <p>
              {term.definition}{" "}
              <a href={term.route}>
                Read the explanation<span aria-hidden="true"> →</span>
              </a>
            </p>
            <p class="source-note">
              {term.source_ref_ids.map((id) => {
                const ref = sourceDirectory.references.find(
                  (ref) => ref.id === id,
                )!;
                return (
                  <>
                    <a href={ref.url}>Source</a>: {ref.locator}.{" "}
                  </>
                );
              })}
            </p>
          </>
        ))}
      </>
    )}
  </div>
  <DataPanels ids={article.data_ids ?? []} />
  {card && (
    <section id="evidence-data" class="article-extra">
      <h2>The data behind this example</h2>
      {!card.replacesTable && <Fragment set:html={evidenceTable(card)} />}
      <p class="source-note">{card.scope}</p>
      <ul class="source-note">
        {card.data.limitations.map((limit) => (
          <li>{limit}</li>
        ))}
      </ul>
      <a href={`/data/${card.data.id}.json`} download>
        Download the source-linked data (JSON)<span aria-hidden="true"> ↓</span>
      </a>
      <p class="fine-print">
        Research checked {dateLabel(card.data.checked_at)}. Not a live data
        feed.
      </p>
    </section>
  )}
  <aside class="task">
    <h2>{copy.article_labels.task}</h2>
    <p>{article.reader_task}</p>
  </aside>
  <nav class="related" aria-label="Related articles">
    <h2>{copy.article_labels.related}</h2>
    <ul>
      {article.related.map((related) => (
        <li>
          <a href={related.route}>
            {related.title} <span aria-hidden="true">→</span>
          </a>
        </li>
      ))}
    </ul>
  </nav>
  <Pager article={article} />
  <details class="sources" id="sources" open>
    <summary>Sources and scope ({article.sources.length})</summary>
    <p class="source-note">
      The check date records a research check, not continuous monitoring or a
      guarantee of current law.
    </p>
    <ol>
      {article.sources.map((source) => (
        <li id={`source-${source.number}`}>
          <a href={source.url}>{source.title}</a>
          <p>
            {source.publisher} · {source.locator}
          </p>
          {source.kind === "official_primary_mirror" && (
            <p>Official-origin document on a third-party mirror.</p>
          )}
          {(source.version ||
            source.published_at ||
            source.reference_period) && (
            <p>
              {source.version && (
                <>
                  <b>Edition:</b> {source.version}
                </>
              )}
              {source.published_at && (
                <>
                  {source.version && <br />}
                  <b>Published:</b> {source.published_at}
                </>
              )}
              {source.reference_period && (
                <>
                  {(source.version || source.published_at) && <br />}
                  <b>Reference period:</b> {source.reference_period}
                </>
              )}
            </p>
          )}
          {source.limitations.length > 0 && (
            <p>
              <b>Limits:</b> {source.limitations.join(" ")}
            </p>
          )}
          <p class="fine-print">
            Source checked {dateLabel(source.checked_at)}.
          </p>
        </li>
      ))}
    </ol>
  </details>
  <details id="correction" class="correction" data-article-id={article.id}>
    <summary>{copy.article_labels.correction}</summary>
    <p class="source-note">
      Prepare a draft to copy or download. Nothing is sent or saved by this
      website; a submission destination has not been configured.
    </p>
    <label for="correction-draft">Correction draft</label>
    <textarea
      id="correction-draft"
      name="correction"
      autocomplete="off"
      spellcheck="true"
    >{correction}</textarea>
    <div class="correction-actions">
      <button class="btn" id="copy-correction" hidden>
        Copy draft
      </button>
      <a
        id="download-correction"
        class="btn"
        href={`data:text/plain;charset=utf-8,${encodeURIComponent(correction)}`}
        download={`${article.id}-correction.txt`}
      >
        Download draft
      </a>
    </div>
    <p id="correction-status" class="status" role="status"></p>
  </details>
  <p class="meta bottom">
    Article version {article.version}. Research checked{" "}
    {dateLabel(article.research_checked_at)}.<br />
    Assistant source checks; not independently human-reviewed.{" "}
    <a href="/in/reference/how-we-know">How we know</a>
    {" · "}
    <a href="/in/reference/corrections">Corrections</a>.
  </p>
</article>
<script>
  const sources = document.querySelector<HTMLDetailsElement>("#sources");
  if (sources && !/^#source-\d+$/.test(window.location.hash))
    sources.open = false;
  const openSource = (hash: string) => {
    if (!/^#source-\d+$/.test(hash) || !sources) return;
    const target = document.getElementById(hash.slice(1));
    if (!target || !sources.contains(target)) return;
    const wasClosed = !sources.open;
    sources.open = true;
    if (wasClosed) {
      requestAnimationFrame(() =>
        target.scrollIntoView({ behavior: "instant", block: "start" }),
      );
    }
  };
  openSource(window.location.hash);
  window.addEventListener("hashchange", () => openSource(window.location.hash));
  document.addEventListener("click", (event) => {
    if (!(event.target instanceof Element)) return;
    const citation = event.target.closest<HTMLAnchorElement>(
      'a.citation[href^="#source-"]',
    );
    if (citation) openSource(citation.hash);
  });
  const openCorrection = () => {
    if (window.location.hash === "#correction") {
      const panel = document.querySelector<HTMLDetailsElement>("#correction");
      if (panel) panel.open = true;
    }
  };
  openCorrection();
  window.addEventListener("hashchange", openCorrection);
  document.addEventListener("click", (event) => {
    if (
      event.target instanceof Element &&
      event.target.closest('a[href="#correction"]')
    ) {
      const panel = document.querySelector<HTMLDetailsElement>("#correction");
      if (panel) panel.open = true;
    }
  });
  const draft =
    document.querySelector<HTMLTextAreaElement>("#correction-draft")!;
  const copyButton =
    document.querySelector<HTMLButtonElement>("#copy-correction")!;
  const download = document.querySelector<HTMLAnchorElement>(
    "#download-correction",
  )!;
  const status = document.querySelector<HTMLElement>("#correction-status")!;
  copyButton.hidden = false;
  draft.addEventListener("input", () => {
    download.href = `data:text/plain;charset=utf-8,${encodeURIComponent(draft.value)}`;
    status.textContent = "";
  });
  copyButton.addEventListener("click", async () => {
    try {
      await navigator.clipboard.writeText(draft.value);
      status.textContent = "Draft copied. Nothing has been submitted.";
    } catch {
      draft.focus();
      draft.select();
      status.textContent = "Select and copy the draft, or download it below.";
    }
  });
</script>
