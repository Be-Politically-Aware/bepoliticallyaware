---
import { copy, paths, byId } from "../lib/content";
import { navSections } from "../lib/nav";
import { evidence } from "../lib/evidence";
interface Props {
  country?: boolean;
}
const { country = false } = Astro.props;
---

<div class="article home-content">
  <section class="hero">
    <p class="context">{copy.hero.eyebrow}</p>
    <h1>{copy.hero.title}</h1>
    <p class="summary">{copy.hero.description}</p>
    <div class="hero-actions">
      <a href={copy.hero.primary_cta.route}>
        {copy.hero.primary_cta.label}
        <span aria-hidden="true"> →</span>
      </a>
      <a href={copy.hero.secondary_cta.route}>
        {copy.hero.secondary_cta.label}
        <span aria-hidden="true"> →</span>
      </a>
    </div>
  </section>
  <section class="home-section" aria-labelledby="questions-title">
    <h2 id="questions-title">Start with a question</h2>
    <ul class="reading-list">
      {copy.entry_questions.map((q) => (
        <li>
          <a class="guide-row" href={q.route}>
            <span class="row-title">
              {q.label}
              <span aria-hidden="true"> →</span>
            </span>
          </a>
        </li>
      ))}
    </ul>
  </section>
  {country && (
    <section class="home-section">
      <h2>Browse by topic</h2>
      <nav aria-label="Guide topics">
        <ul class="reading-list">
          {navSections.map((section) => (
            <li>
              <a class="guide-row" href={section.route}>
                <span class="row-title">
                  {section.label}
                  <span aria-hidden="true"> →</span>
                </span>
                <span class="row-meta">
                  {section.hubs.flatMap((hub) => hub.articles).length} guides
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>
  )}
  <section class="home-section" aria-labelledby="paths-title">
    <h2 id="paths-title">Suggested reading paths</h2>
    <ul class="reading-list">
      {paths.slice(0, 3).map((p) => (
        <li>
          <a class="guide-row" href={p.route}>
            <span class="row-title">
              {p.title}
              <span aria-hidden="true"> →</span>
            </span>
            <span class="row-summary">
              {p.articles.length} short guides. {p.outcome}
            </span>
          </a>
        </li>
      ))}
    </ul>
    <p class="section-end">
      <a href="/in/paths">
        All reading paths<span aria-hidden="true"> →</span>
      </a>
    </p>
  </section>
  <section class="home-section" aria-labelledby="evidence-title">
    <h2 id="evidence-title">Dated evidence</h2>
    <ul class="reading-list">
      {evidence.slice(0, 2).map((card) => (
        <li>
          <a class="guide-row" href={byId.get(card.articleId)!.route}>
            <span class="row-title">
              {card.data.title}
              <span aria-hidden="true"> →</span>
            </span>
            <span class="row-summary">{card.data.reference_period}</span>
          </a>
        </li>
      ))}
    </ul>
    <p class="section-end">
      <a href="/in/library#dated-evidence">
        Explore the evidence library<span aria-hidden="true"> →</span>
      </a>
    </p>
  </section>
  {!country && (
    <section class="home-section">
      <h2>Browse by topic</h2>
      <nav aria-label="Guide topics">
        <ul class="reading-list">
          {navSections.map((section) => (
            <li>
              <a class="guide-row" href={section.route}>
                <span class="row-title">
                  {section.label}
                  <span aria-hidden="true"> →</span>
                </span>
                <span class="row-meta">
                  {section.hubs.flatMap((hub) => hub.articles).length} guides
                </span>
              </a>
            </li>
          ))}
        </ul>
      </nav>
    </section>
  )}
  <p class="source-note section-end">{copy.country_note}</p>
</div>
