---
import { copy, paths, navigation, byId } from "../lib/content";
import { evidence } from "../lib/evidence";
interface Props {
  country?: boolean;
}
const { country = false } = Astro.props;
---

<section class="hero">
  <p class="kicker">{copy.hero.eyebrow}</p>
  <h1>{copy.hero.title}</h1>
  <p class="lead">{copy.hero.description}</p>
  <div class="hero-links">
    <a href={copy.hero.primary_cta.route}>{copy.hero.primary_cta.label}</a>
    <a href={copy.hero.secondary_cta.route}>{copy.hero.secondary_cta.label}</a>
  </div>
</section>
<section class="home-section" aria-labelledby="questions-title">
  <h2 id="questions-title">Start with a question</h2>
  <ul class="question-list">
    {copy.entry_questions.map((q) => (
      <li>
        <a href={q.route}>{q.label}</a>
      </li>
    ))}
  </ul>
</section>
{country && (
  <section class="home-section">
    <h2>Explore the guides</h2>
    <nav class="topic-links" aria-label="Guide topics">
      {navigation.primary.map((p) => (
        <a href={p.route}>{p.label}</a>
      ))}
    </nav>
    <p class="source-note section-end">{copy.country_note}</p>
  </section>
)}
<section class="home-section" aria-labelledby="paths-title">
  <h2 id="paths-title">A little direction, if you need it</h2>
  <ul class="reading-list">
    {paths.slice(0, 3).map((p) => (
      <li>
        <a href={p.route}>{p.title}</a>
        <p>
          {p.articles.length} short guides. {p.outcome}
        </p>
      </li>
    ))}
  </ul>
  <p class="section-end">
    <a href="/in/paths">All reading paths</a>
  </p>
</section>
<section class="home-section" aria-labelledby="evidence-title">
  <h2 id="evidence-title">Read the numbers, not just the headline</h2>
  <p class="source-note">
    Dated examples, with the sources, definitions and limitations alongside.
  </p>
  <ul class="reading-list">
    {evidence.slice(0, 2).map((card) => (
      <li>
        <a href={byId.get(card.articleId)!.route}>{card.data.title}</a>
        <p>{card.data.reference_period}</p>
      </li>
    ))}
  </ul>
  <p class="section-end">
    <a href="/in/library#dated-evidence">Explore the evidence library</a>
  </p>
</section>
{!country && (
  <section class="home-section">
    <h2>Go at your own pace</h2>
    <nav class="topic-links" aria-label="Guide topics">
      {navigation.primary.map((p) => (
        <a href={p.route}>{p.label}</a>
      ))}
    </nav>
    <p class="source-note section-end">{copy.country_note}</p>
  </section>
)}
