---
import Site from "../layouts/Site.astro";
---

<Site title="Search" noindex>
  <p class="breadcrumb">
    <a href="/in">India guides</a>
  </p>
  <h1>Find a clearer answer.</h1>
  <p class="lead">Search the guides by question, institution or issue.</p>
  <form id="search-form" class="search-form" action="/search">
    <label for="search-query">Search articles</label>
    <div class="search-controls">
      <input
        id="search-query"
        type="search"
        name="q"
        placeholder="Try “RTI” or “roads”"
        autocomplete="off"
      />
      <button type="submit">Search</button>
    </div>
  </form>
  <p class="search-status" id="search-status" role="status"></p>
  <ul
    id="search-results"
    class="reading-list search-results"
    aria-label="Search results"
  ></ul>
  <noscript>
    <p>
      Search needs JavaScript. You can still{" "}
      <a href="/in">browse every guide by topic</a> or use the{" "}
      <a href="/in/reference/glossary">glossary</a>.
    </p>
  </noscript>
</Site>
