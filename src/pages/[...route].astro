---
import Site from "../layouts/Site.astro";
import Article from "../components/Article.astro";
import { articles, sections, paths, byId, navigation } from "../lib/content";
import { evidence } from "../lib/evidence";
export function getStaticPaths() {
  return [
    ...articles.map((article) => ({
      params: { route: article.route.slice(1) },
      props: { article, section: undefined, path: undefined },
    })),
    ...sections.map((section) => ({
      params: { route: section.route.slice(1) },
      props: { section, article: undefined, path: undefined },
    })),
    ...paths.map((path) => ({
      params: { route: path.route.slice(1) },
      props: { path, article: undefined, section: undefined },
    })),
  ];
}
const { article, section, path } = Astro.props;
const title = article?.title ?? section?.label ?? path!.title;
const groups = section
  ? navigation.hubs.filter((h) => section.hubs.includes(h.id))
  : [];
---

<Site title={title} description={article?.summary ?? path?.outcome}>
  {article ? (
    <Article article={article} />
  ) : (
    <>
      <nav class="breadcrumb" aria-label="Breadcrumb">
        <a href="/in">India guides</a>
        {path && (
          <>
            {" "}
            / <a href="/in/paths">Reading paths</a>
          </>
        )}
      </nav>
      <h1>{title}</h1>
      {path ? (
        <>
          <p class="lead">{path.outcome}</p>
          <p class="source-note">
            {path.articles.length} guides, in a suggested order. Read at your
            own pace.
          </p>
          <ol class="path-list">
            {path.articles.map((a) => (
              <li>
                <a href={a.route}>{a.title}</a>
                <p>{a.summary}</p>
                <span class="fine-print">
                  {a.estimated_reading_minutes} min read
                </span>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <p class="source-note">
            Clear explanations, with sources and a practical next step.
          </p>
          {groups.map((group) => (
            <section class="page-section">
              <h2>{group.label}</h2>
              <ul class="reading-list">
                {section!.articles
                  .filter((a) => a.hub === group.id)
                  .map((a) => (
                    <li>
                      <a href={a.route}>{a.title}</a>
                      <p>{a.summary}</p>
                      <span class="fine-print">
                        {a.estimated_reading_minutes} min read
                      </span>
                    </li>
                  ))}
              </ul>
            </section>
          ))}
          {section?.route === "/in/library" && (
            <section class="page-section" id="dated-evidence">
              <h2>Dated evidence</h2>
              <p class="source-note">
                Four worked examples. Keep the category, date and denominator
                with the number.
              </p>
              <ul class="reading-list">
                {evidence.map((card) => (
                  <li>
                    <a
                      href={`${byId.get(card.articleId)!.route}#evidence-data`}
                    >
                      {card.data.title}
                    </a>
                    <p>{card.data.reference_period}</p>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      )}
    </>
  )}
</Site>
