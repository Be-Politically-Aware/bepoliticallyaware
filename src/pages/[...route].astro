---
import Site from "../layouts/Site.astro";
import Article from "../components/Article.astro";
import { articles, sections, paths, byId, navigation } from "../lib/content";
import { getNavigation } from "../lib/nav";
import { evidence } from "../lib/evidence";
export function getStaticPaths() {
  return [
    ...articles.map((article) => ({
      params: { route: article.route.slice(1) },
      props: { article, section: undefined, path: undefined },
    })),
    ...sections.map((section) => ({
      params: { route: section.route.slice(1) },
      props: { section, article: undefined, path: undefined },
    })),
    ...paths.map((path) => ({
      params: { route: path.route.slice(1) },
      props: { path, article: undefined, section: undefined },
    })),
  ];
}
const { article, section, path } = Astro.props;
const title = article?.title ?? section?.label ?? path!.title;
const groups = section
  ? navigation.hubs.filter((h) => section.hubs.includes(h.id))
  : [];
const context = getNavigation(section?.route ?? path?.route ?? article!.route);
const parentSection =
  section && context.section?.route !== section.route
    ? context.section
    : undefined;
---

<Site title={title} description={article?.summary ?? path?.outcome}>
  {article ? (
    <Article article={article} />
  ) : (
    <div class="article">
      <nav class="context" aria-label="Breadcrumb">
        <ol>
          <li>
            <a href="/in">India</a>
          </li>
          {path && (
            <li>
              <span aria-hidden="true">/</span>
              <a href="/in/paths">Reading paths</a>
            </li>
          )}
          {parentSection && (
            <li>
              <span aria-hidden="true">/</span>
              <a href={parentSection.route}>{parentSection.label}</a>
            </li>
          )}
        </ol>
      </nav>
      <h1>{title}</h1>
      {path ? (
        <>
          <p class="summary">{path.outcome}</p>
          <p class="source-note">
            {path.articles.length} guides, in a suggested order. Read at your
            own pace.
          </p>
          <ol class="steps">
            {path.articles.map((a) => (
              <li>
                <a class="guide-row" href={a.route}>
                  <span class="row-title">
                    {a.title}
                    <span aria-hidden="true"> →</span>
                  </span>
                  <span class="row-summary">{a.summary}</span>
                  <span class="row-meta">
                    {a.estimated_reading_minutes} min read
                  </span>
                </a>
              </li>
            ))}
          </ol>
        </>
      ) : (
        <>
          <p class="summary">
            Clear explanations, with sources and a practical next step.
          </p>
          {groups.map((group) => (
            <section class="page-section">
              <h2>{group.label}</h2>
              <ul class="reading-list">
                {section!.articles
                  .filter((a) => a.hub === group.id)
                  .map((a) => (
                    <li>
                      <a class="guide-row" href={a.route}>
                        <span class="row-title">
                          {a.title}
                          <span aria-hidden="true"> →</span>
                        </span>
                        <span class="row-summary">{a.summary}</span>
                        <span class="row-meta">
                          {a.estimated_reading_minutes} min read
                        </span>
                      </a>
                    </li>
                  ))}
              </ul>
            </section>
          ))}
          {section?.route === "/in/library" && (
            <section class="page-section" id="dated-evidence">
              <h2>Dated evidence</h2>
              <p class="source-note">
                Four worked examples. Keep the category, date and denominator
                with the number.
              </p>
              <ul class="reading-list">
                {evidence.map((card) => (
                  <li>
                    <a
                      class="guide-row"
                      href={`${byId.get(card.articleId)!.route}#evidence-data`}
                    >
                      <span class="row-title">
                        {card.data.title}
                        <span aria-hidden="true"> →</span>
                      </span>
                      <span class="row-summary">
                        {card.data.reference_period}
                      </span>
                    </a>
                  </li>
                ))}
              </ul>
            </section>
          )}
        </>
      )}
    </div>
  )}
</Site>
