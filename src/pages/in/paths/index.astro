---
import Site from "../../../layouts/Site.astro";
import { paths } from "../../../lib/content";
---

<Site title="Reading paths">
  <p class="breadcrumb">
    <a href="/in">India guides</a>
  </p>
  <h1>
    A question. A few guides.
    <br />A clearer way forward.
  </h1>
  <p class="lead">
    Choose what brought you here. Each path gives you a short, useful sequence
    to follow.
  </p>
  <ul class="reading-list page-section">
    {paths.map((p) => (
      <li>
        <a href={p.route}>{p.title}</a>
        <p>{p.outcome}</p>
        <span class="fine-print">{p.articles.length} guides</span>
      </li>
    ))}
  </ul>
</Site>
