---
import Site from "../../../layouts/Site.astro";
import { paths } from "../../../lib/content";
---

<Site>
  <div class="article">
    <nav class="context" aria-label="Breadcrumb">
      <ol>
        <li>
          <a href="/in">India</a>
        </li>
      </ol>
    </nav>
    <h1>Reading paths</h1>
    <p class="summary">
      Short sequences of guides, each starting from a common question.
    </p>
    <ul class="reading-list page-section">
      {paths.map((p) => (
        <li>
          <a class="guide-row" href={p.route}>
            <span class="row-title">
              {p.title}
              <span aria-hidden="true"> →</span>
            </span>
            <span class="row-summary">{p.outcome}</span>
            <span class="row-meta">{p.articles.length} guides</span>
          </a>
        </li>
      ))}
    </ul>
  </div>
</Site>
