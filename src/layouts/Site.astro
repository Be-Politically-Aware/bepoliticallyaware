---
import "../styles/global.css";
import { articles, copy } from "../lib/content";
import SearchDialog from "../components/SearchDialog.astro";
import Sidebar from "../components/Sidebar.astro";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = copy.hero.description,
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
const links = [
  { label: "Guides", route: "/in" },
  { label: "Reading paths", route: "/in/paths" },
  { label: "Glossary", route: "/in/reference/glossary" },
  { label: "Sources", route: "/sources" },
];
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${copy.site_name}` : copy.site_name}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta
      name="theme-color"
      content="#fffefb"
      media="(prefers-color-scheme: light)"
    />
    <meta
      name="theme-color"
      content="#111614"
      media="(prefers-color-scheme: dark)"
    />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body class="bg-paper font-sans text-ink">
    <a class="skip-link btn" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <div class="container header-inner">
        <div class="header-brand">
          <a class="wordmark" href="/" translate="no">
            {copy.site_name}
          </a>
          <span class="edition">India edition</span>
        </div>
        <div class="header-actions">
          <nav class="header-links" aria-label="Main navigation">
            {links.map((link) => (
              <a
                href={link.route}
                aria-current={pathname === link.route ? "page" : undefined}
              >
                {link.label}
              </a>
            ))}
          </nav>
          <a
            class="search-trigger"
            data-open-search
            href="/search"
            aria-label="Search"
            aria-keyshortcuts="Meta+K Control+K /"
          >
            <svg
              class="search-icon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="10.5" cy="10.5" r="6.5" />
              <path d="m16 16 4.5 4.5" />
            </svg>
            <span class="search-label">Search</span>{" "}
            <kbd aria-hidden="true">⌘ K</kbd>
          </a>
          <button
            id="theme-toggle"
            class="icon-button theme-toggle"
            aria-label="Switch to dark mode"
            hidden
          >
            <svg
              class="moon"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <path d="M20.8 13.4A9 9 0 0 1 10.6 3.2a9 9 0 1 0 10.2 10.2Z" />
            </svg>
            <svg
              class="sun"
              width="18"
              height="18"
              viewBox="0 0 24 24"
              fill="none"
              stroke="currentColor"
              stroke-width="1.5"
              aria-hidden="true"
            >
              <circle cx="12" cy="12" r="4" />
              <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
            </svg>
          </button>
        </div>
      </div>
    </header>
    <div class="layout">
      <div class="desktop-sidebar">
        <Sidebar route={pathname} />
      </div>
      <details class="mobile-index">
        <summary>Browse all {articles.length} articles</summary>
        <Sidebar route={pathname} mobile />
      </details>
      <main class="main-pane" id="main" tabindex="-1">
        <slot />
      </main>
    </div>
    <footer class="site-footer">
      <div class="container footer-inner">
        <p class="footer-brand">Understand more. Ask better questions.</p>
        <nav aria-label="Footer navigation">
          <a href="/in/reference/how-we-know">How we know</a>
          {" · "}
          <a href="/sources">Sources</a>
          {" · "}
          <a href="/in/reference/corrections">Corrections</a>
        </nav>
        <p class="fine-print">
          General civic education, not individual legal advice.
          <br />
          Not a live-news service. No tracking. No account needed.
        </p>
      </div>
    </footer>
    <SearchDialog />
    <script>
      const button =
        document.querySelector<HTMLButtonElement>("#theme-toggle")!;
      function sync() {
        const dark = document.documentElement.dataset.theme === "dark";
        button.setAttribute(
          "aria-label",
          `Switch to ${dark ? "light" : "dark"} mode`,
        );
        button.title = button.getAttribute("aria-label")!;
        document
          .querySelectorAll<HTMLMetaElement>('meta[name="theme-color"]')
          .forEach((meta) => {
            meta.content = dark ? "#111614" : "#fffefb";
          });
      }
      button.hidden = false;
      sync();
      button.addEventListener("click", () => {
        const theme =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem("theme", theme);
        } catch {
          /* Use the selected theme without storage. */
        }
        sync();
      });
      document
        .querySelectorAll<HTMLElement>(".table-scroll")
        .forEach((table) => {
          table.addEventListener("keydown", (event) => {
            if (
              event.target === table &&
              (event.key === "ArrowLeft" || event.key === "ArrowRight")
            ) {
              event.preventDefault();
              table.scrollBy({
                left: event.key === "ArrowRight" ? 120 : -120,
                behavior: "instant",
              });
            }
          });
        });
    </script>
  </body>
</html>
