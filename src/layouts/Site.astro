---
import "../styles/global.css";
import { copy } from "../lib/content";
import SearchDialog from "../components/SearchDialog.astro";
interface Props {
  title?: string;
  description?: string;
  noindex?: boolean;
}
const {
  title,
  description = copy.hero.description,
  noindex = false,
} = Astro.props;
const pathname = Astro.url.pathname.replace(/\/$/, "") || "/";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title ? `${title} | ${copy.site_name}` : copy.site_name}</title>
    <meta name="description" content={description} />
    <meta name="color-scheme" content="light dark" />
    <meta name="referrer" content="strict-origin-when-cross-origin" />
    {noindex && <meta name="robots" content="noindex" />}
    <link rel="canonical" href={new URL(pathname, Astro.site)} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <script is:inline src="/theme.js"></script>
  </head>
  <body>
    <a class="skip-link" href="#main">
      Skip to content
    </a>
    <header class="site-header">
      <a class="wordmark" href="/">
        Be Politically Aware<span class="edition">India edition</span>
      </a>
      <nav aria-label="Main navigation">
        <a href="/in" aria-current={pathname === "/in" ? "page" : undefined}>
          Guides
        </a>
        <a
          href="/in/reference/glossary"
          aria-current={
            pathname === "/in/reference/glossary" ? "page" : undefined
          }
        >
          Glossary
        </a>
        <a
          class="search-trigger"
          data-open-search
          href="/search"
          aria-keyshortcuts="Meta+K Control+K /"
        >
          Search <kbd aria-hidden="true">⌘ K</kbd>
        </a>
        <button
          id="theme-toggle"
          class="theme-toggle"
          aria-label="Switch to dark mode"
          title="Switch theme"
          hidden
        >
          <svg
            class="moon"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <path d="M20.8 13.4A9 9 0 0 1 10.6 3.2a9 9 0 1 0 10.2 10.2Z" />
          </svg>
          <svg
            class="sun"
            width="18"
            height="18"
            viewBox="0 0 24 24"
            fill="none"
            stroke="currentColor"
            stroke-width="1.5"
            aria-hidden="true"
          >
            <circle cx="12" cy="12" r="4" />
            <path d="M12 2v2m0 16v2M2 12h2m16 0h2M5 5l1.5 1.5m11 11L19 19M5 19l1.5-1.5m11-11L19 5" />
          </svg>
        </button>
      </nav>
    </header>
    <main id="main" tabindex="-1">
      <slot />
    </main>
    <footer class="site-footer">
      <p>Understand more. Ask better questions.</p>
      <nav aria-label="Footer navigation">
        <a href="/in/reference/how-we-know">How we know</a>
        <a href="/sources">Sources</a>
        <a href="/in/reference/corrections">Corrections</a>
      </nav>
      <p class="fine-print">
        General civic education, not individual legal advice.
        <br />
        Not a live-news service. No tracking. No account needed.
      </p>
    </footer>
    <SearchDialog />
    <script>
      const button =
        document.querySelector<HTMLButtonElement>("#theme-toggle")!;
      const media = window.matchMedia("(prefers-color-scheme: dark)");
      function sync() {
        const dark = document.documentElement.dataset.theme === "dark";
        button.setAttribute(
          "aria-label",
          `Switch to ${dark ? "light" : "dark"} mode`,
        );
        button.title = button.getAttribute("aria-label")!;
      }
      button.hidden = false;
      sync();
      button.addEventListener("click", () => {
        const theme =
          document.documentElement.dataset.theme === "dark" ? "light" : "dark";
        document.documentElement.dataset.theme = theme;
        try {
          localStorage.setItem("theme", theme);
        } catch {
          /* Theme still works when storage is unavailable. */
        }
        sync();
      });
      media.addEventListener("change", (event) => {
        let saved = false;
        try {
          saved = !!localStorage.getItem("theme");
        } catch {
          /* Use the system preference. */
        }
        if (!saved) {
          document.documentElement.dataset.theme = event.matches
            ? "dark"
            : "light";
          sync();
        }
      });
      document
        .querySelectorAll<HTMLElement>(".table-scroll")
        .forEach((table) => {
          table.addEventListener("keydown", (event) => {
            if (
              event.target === table &&
              (event.key === "ArrowLeft" || event.key === "ArrowRight")
            ) {
              event.preventDefault();
              table.scrollBy({
                left: event.key === "ArrowRight" ? 120 : -120,
                behavior: "instant",
              });
            }
          });
        });
    </script>
  </body>
</html>
